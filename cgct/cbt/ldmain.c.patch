 }
 
+/* Dynamic prefix */
+
+const char*
+cgct_app_prefix(const char* path) {
+  static char prefix[PATH_MAX];
+  if (CGCT_GETENV_PREFIX)
+    strcpy(prefix, CGCT_GETENV_PREFIX);
+  else
+    strcpy(prefix, CGCT_DEFAULT_PREFIX);
+  strcat(prefix, path);
+  return prefix;
+}
